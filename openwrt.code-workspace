{
	"folders": [
		{
			"path": ".",
			"name": "openwrt"
		},
		{
			"path": "../openwrt-builder",
			"name": "Builder"
		},
		{
			"path": "../openwrt-config",
			"name": "Config (Ansible)"
		},
		{
			"path": "../kleinbem-secrets",
			"name": "Secrets"
		}
	],
	"settings": {
		"editor.formatOnSave": true,
		"files.watcherExclude": {
			"**/result": true,
			"**/result-*": true,
			"**/.direnv": true
		},
		"files.exclude": {
			"**/.git": true,
			"**/.DS_Store": true,
			"**/*.direnv": true,
			"**/result": true,
			"**/result-*": true,
			"**/node_modules": true,
			"nix-*": true
		},
		"files.associations": {
			"Justfile": "makefile",
			"*.nix": "nix"
		},
		"[nix]": {
			"editor.defaultFormatter": "jnoortheen.nix-ide"
		},
		"nix.enableLanguageServer": true,
		"nix.serverPath": "nixd",
		"nix.formatterPath": "nixfmt",
		"nixEnvSelector.nixFile": "${workspaceFolder}/flake.nix",
		"nixEnvSelector.useFlakes": true
	},
	"extensions": {
		"recommendations": [
			"bbenoist.nix",
			"skellock.just",
			"mkhl.direnv",
			"redhat.ansible",
			"signageos.signageos-vscode-sops",
			"jnoortheen.nix-ide"
		]
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "Update All Repos",
				"type": "shell",
				"command": "just jj::sync",
				"group": {
					"kind": "build",
					"isDefault": false
				},
				"problemMatcher": []
			},
			{
				"label": "Check Status",
				"type": "shell",
				"command": "just status-all",
				"group": "test",
				"problemMatcher": []
			},
			{
				"label": "Build Image",
				"type": "shell",
				"command": "just build",
				"group": "build",
				"problemMatcher": []
			}
		]
	}
}
